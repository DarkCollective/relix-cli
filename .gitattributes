# Normalise line endings in the repository; check out with the platform's own.
* text=auto

# Scripts that must keep their line endings whatever the platform.
gradlew        text eol=lf
*.sh           text eol=lf
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf
# Relix scripts: the tests compare what fmt and optimize write with them byte for byte.
*.relix        text eol=lf
# The command-line guide: its command pages are generated, and compared with the
# generator's output byte for byte.
docs/guide/command-line/**  text eol=lf
docs/command-examples/**    text eol=lf

# Binary files.
*.jar          binary
*.png          binary
*.ico          binary
*.zip          binary
*.gz           binary
