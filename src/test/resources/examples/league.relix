-- ─── Five-a-Side League ──────────────────────────────────────────────────────
-- A fictional five-a-side football league, three rounds played so far.
-- Run:  relix --exec examples/league.relix

namespace league;

-- ─── Master data ─────────────────────────────────────────────────────────────

Teams := [| team_id | name           | city        | founded |
           | 1       | Red Rockets    | London      |    2010 |
           | 2       | Blue Bolts     | Manchester  |    2008 |
           | 3       | Green Giants   | Birmingham  |    2015 |
           | 4       | Yellow Yellows | Leeds       |    2012 |
           | 5       | Purple Pythons | Bristol     |    2018 |
           ];

Players := [| player_id | name          | team_id | position | age |
             | 1         | Sam Shaw      | 1       | striker  |  28 |
             | 2         | Tom Turner    | 1       | keeper   |  31 |
             | 3         | Lena Lopez    | 2       | striker  |  25 |
             | 4         | Kai Kim       | 2       | mid      |  27 |
             | 5         | Ravi Patel    | 3       | striker  |  24 |
             | 6         | Mia Moore     | 3       | mid      |  29 |
             | 7         | Joe Jones     | 4       | striker  |  33 |
             | 8         | Ana Anand     | 4       | keeper   |  26 |
             | 9         | Ben Baker     | 5       | striker  |  22 |
             | 10        | Zoe Zhang     | 5       | mid      |  30 |
             ];

-- Each match records home and away teams, goals scored, and the round number
Matches := [| match_id | home_id | away_id | home_goals | away_goals | round |
             | 1        | 1       | 2       |          3 |          1 |     1 |
             | 2        | 3       | 4       |          0 |          2 |     1 |
             | 3        | 5       | 1       |          1 |          1 |     1 |
             | 4        | 2       | 3       |          2 |          2 |     2 |
             | 5        | 4       | 5       |          3 |          0 |     2 |
             | 6        | 1       | 3       |          2 |          0 |     2 |
             | 7        | 2       | 4       |          1 |          1 |     3 |
             | 8        | 5       | 3       |          2 |          3 |     3 |
             | 9        | 1       | 4       |          4 |          2 |     3 |
             ];

Goals := [| goal_id | match_id | player_id | minute |
           | 1       | 1        | 1         |     12 |
           | 2       | 1        | 1         |     34 |
           | 3       | 1        | 4         |     45 |
           | 4       | 1        | 1         |     67 |
           | 5       | 2        | 7         |     23 |
           | 6       | 2        | 7         |     55 |
           | 7       | 3        | 9         |     30 |
           | 8       | 3        | 1         |     72 |
           | 9       | 4        | 3         |     18 |
           | 10      | 4        | 3         |     60 |
           | 11      | 4        | 5         |     40 |
           | 12      | 4        | 6         |     80 |
           | 13      | 5        | 7         |     15 |
           | 14      | 5        | 7         |     44 |
           | 15      | 5        | 7         |     70 |
           | 16      | 6        | 1         |     25 |
           | 17      | 6        | 2         |     58 |  -- keepers get on the scoresheet too
           | 18      | 7        | 3         |     37 |
           | 19      | 7        | 7         |     62 |
           | 20      | 8        | 9         |     10 |
           | 21      | 8        | 5         |     33 |
           | 22      | 8        | 6         |     50 |
           | 23      | 8        | 9         |     62 |
           | 24      | 8        | 5         |     88 |
           | 25      | 9        | 1         |      8 |
           | 26      | 9        | 1         |     29 |
           | 27      | 9        | 7         |     41 |
           | 28      | 9        | 1         |     63 |
           | 29      | 9        | 1         |     77 |
           | 30      | 9        | 8         |     55 |  -- and so does the other one
           ];

-- ─── Derived relations ───────────────────────────────────────────────────────

-- Rename match columns so we can distinguish home vs away in joins
HomeView := { ρ HomeView(match_id, team_id, goals_for, goals_against, round) (
    π match_id, home_id, home_goals, away_goals, round (Matches)
) };

AwayView := { ρ AwayView(match_id, team_id, goals_for, goals_against, round) (
    π match_id, away_id, away_goals, home_goals, round (Matches)
) };

-- All results from each team's perspective
AllResults := { HomeView ∪ AwayView };

-- ─── Queries ─────────────────────────────────────────────────────────────────

-- Top scorers (players with at least 2 goals), sorted descending
GoalTally := { γ player_id, COUNT(goal_id) → goals (Goals) };
TopScorers := {
    τ goals DESC (
        π name, goals (
            σ goals >= 2 (GoalTally ⋈ Players)
        )
    )
};

-- Rename GoalTally so scorer_id ≠ player_id; this lets the semi/anti-join
-- predicate resolve the two sides unambiguously (qualifier stripping is safe
-- only when the column names differ between left and right).
ScoredBy := { ρ ScoredBy(scorer_id, goals) (GoalTally) };

-- Strikers who have scored at least one goal (semi-join)
StrikersScoredAGoal := {
    σ position = "striker" (Players)
    ⋉ Players.player_id = ScoredBy.scorer_id
    ScoredBy
};

-- Players who have NOT scored yet (anti-join)
NotYetScored := {
    Players ▷ Players.player_id = ScoredBy.scorer_id ScoredBy
};

-- Goals per team (Goals → Players gives team_id; join Teams for names)
-- Rename Teams.name → team_name to avoid clashing with Players.name in the join
TeamInfo := { ρ TeamInfo(team_id, team_name, city, founded) (Teams) };

TeamGoals := {
    γ team_id, COUNT(goal_id) → team_goals (
        Goals ⋈ Players
    )
};
TeamGoalsNamed := { π team_name, team_goals (TeamGoals ⋈ TeamInfo) };

-- League standings: union home + away perspectives, then aggregate
-- (HomeView ∪ AwayView already unified above as AllResults)
TeamRecord := {
    γ team_id, COUNT(match_id) → played,
      SUM(goals_for) → scored, SUM(goals_against) → conceded
    (AllResults)
};
Standings := {
    τ scored DESC (
        π team_name, played, scored, conceded (TeamInfo ⋈ TeamRecord)
    )
};

-- Teams that have played in round 3 (semi-join; home_id ≠ team_id — no clash)
Round3Teams := { π home_id (σ round = 3 (Matches)) };
PlayedRound3 := {
    Teams ⋉ Teams.team_id = Round3Teams.home_id Round3Teams
};

-- Distinct cities represented in the league
LeagueCities := { δ (π city (Teams)) };

query TopScorers;
query StrikersScoredAGoal;
query NotYetScored;
query TeamGoalsNamed;
query Standings;
query PlayedRound3;
query LeagueCities;
